# --- 원본 데이터 (24 GB) — DATA.md 의 DOI 로 받는다 ---
raw/

# --- 제3자 저작물 ---
# 참조 논문 PDF (Elsevier).  DOI 로 인용만 한다.
docs/*.pdf
# 데이터셋에 딸려 온 문서 사본.  원본 배포처의 라이선스를 따르므로
# 여기서 재배포하지 않는다.  저자 연락처 같은 개인정보도 들어 있다.
docs/UYPYDJ/
docs/RPCWBY/
docs/Mendeley/

# --- 파생 캐시 (5 GB) — repro/run.py 로 다시 만든다 ---
analysis/cache/
analysis/cache_t/
analysis/backup_pretemp/

# --- 빌드 산출물 (절대 경로가 박힌다) ---
mcu/fw_sop/Build/

# --- 탐색 흔적: 임계 경로가 아니다 (repro/run.py --exploratory) ---
