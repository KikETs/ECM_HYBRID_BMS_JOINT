# ============================================================
#  Not published to the public repository
# ============================================================

# --- Raw data (24 GB) — fetch via the DOIs in DATA.md ---
raw/

# --- Third-party material ---
# Reference paper PDFs (Elsevier).  Cited by DOI only.
docs/*.pdf
# Document copies shipped with the datasets.  They follow the original
# distributor's licence, so they are not redistributed here.  They also
# contain personal data such as author contact details.
docs/UYPYDJ/
docs/RPCWBY/
docs/Mendeley/

# --- Derived caches (5 GB) — rebuilt by repro/run.py ---
analysis/cache/
analysis/cache_t/
analysis/backup_pretemp/

# --- Build artefacts (they embed absolute paths) ---
mcu/fw_sop/Build/

# --- Exploratory traces: not on the critical path (repro/run.py --exploratory) ---
analysis/runs/
analysis/runs_soh/
analysis/runs_soh_drive/
analysis/runs_trim/
analysis/runs_trim_q*/
analysis/runs_trim_cur*/
analysis/runs_trim_w/
analysis/runs_trim_r[0-9]*/
analysis/runs_trim_a8x*/
analysis/runs_trim_*_v3/
analysis/runs_trim_a8_v3/

# --- Intermediate outputs: repro rebuilds them ---
analysis/ev_*.csv
analysis/sop_amps_eval*.csv
analysis/results/eval/
analysis/results/*.pkl
analysis/results/*.pt
analysis/results/soc_perturb.npz
analysis/*.npz
analysis/sop_mcu_bench.csv

__pycache__/
*.pyc

# --- Local Korean originals kept for diffing after translation ---
docs/_ko_backup/
analysis/results/tables_backup/
