# ============================================================
#  Not published to the public repository
# ============================================================

# --- Raw data (24 GB) — fetch via the DOIs in DATA.md ---
raw/

# --- Third-party material ---
# Reference paper PDFs (Elsevier).  Cited by DOI only.
docs/*.pdf
# Document copies shipped with the datasets.  They follow the original
# distributor's licence, so they are not redistributed here.  They also
# contain personal data such as author contact details.
docs/UYPYDJ/
docs/RPCWBY/
docs/Mendeley/

# --- Derived caches (5 GB) — rebuilt by repro/run.py ---
analysis/cache/
analysis/cache_t/
analysis/backup_pretemp/

# --- Build artefacts (they embed absolute paths) ---
mcu/fw_sop/Build/

# --- Exploratory traces: not on the critical path (repro/run.py --exploratory) ---
analysis/runs/
analysis/runs_soh/
analysis/runs_soh_drive/
analysis/runs_trim/
analysis/runs_trim_q*/
analysis/runs_trim_cur*/
analysis/runs_trim_w/
analysis/runs_trim_r[0-9]*/
analysis/runs_trim_a8x*/
analysis/runs_trim_*_v3/
analysis/runs_trim_a8_v3/

# --- Intermediate outputs: repro rebuilds them ---
analysis/ev_*.csv
analysis/sop_amps_eval*.csv
analysis/results/eval/
analysis/results/*.pkl
analysis/results/*.pt
analysis/results/soc_perturb.npz
analysis/*.npz
analysis/sop_mcu_bench.csv

__pycache__/
*.pyc

# --- Local Korean originals kept for diffing after translation ---
docs/_ko_backup/
analysis/results/tables_backup/

# --- audit additions ---
# raw/ is a symlink to the dataset tree during the audit
/raw
# host parity harness binaries (rebuilt by repro/run_parity.py)
mcu/parity_host_audit
mcu/parity_host
mcu/parity_soh
mcu/parity_simd
# pre-audit copies kept locally for diffing
env/*.orig
env/*.csv.orig
# Audit: sequence-model and adaptive-ECM baseline run dirs (rebuilt by
# repro/run_sop_seq_baselines.py); predictions only, no unique artifact.
analysis/runs_trim_lstm*/
analysis/runs_trim_gru*/
analysis/runs_trim_ffrls*/
# Deployment fit: keep the weights, not the 9 MB of predictions.
analysis/runs_trim_*_deploy/pred_*.npz
# Audit: cache_t is a symlink to the local 2.5 GB drive cache.
analysis/cache_t
# Audit: 120 leave-two-out fits for the nested selection (rebuilt by
# repro/run_nested_selection.py --train, ~2.4 h).
analysis/runs_nested/

# These four were committed before the rules above were written, and
# .gitignore does not untrack what is already tracked - 24 MB of regenerable
# predictions went in and had to be removed with `git rm --cached`.
# runs_trim_{lstm,gru,ffrls}: python3 repro/run_sop_seq_baselines.py  (~4 min)
# runs_nested:                python3 repro/run_nested_selection.py --train (~2.4 h)
